# Settings of local/slurm/train_segment.sbatch (and eval.sbatch) for one
# site and one run. Copy to local/slurm/site.env (not under version
# control) and edit; or keep several files and choose one per job with
#   sbatch --export=ALL,OVSB_SITE_ENV=<file> ... local/slurm/train_segment.sbatch
# The file is sourced by bash from the recipe directory; relative paths are
# relative to it.

# --- environment -----------------------------------------------------------
# conda environment with torch, transformers, torchaudio (empty: use the
# python that is on PATH)
OVSB_CONDA_ENV=
# environment modules to load, space separated. The codec chain of the
# training data (data.channel) needs the FFmpeg libraries.
OVSB_MODULES=
# temporary files; on compute nodes /tmp is often a RAM disk
TMPDIR=/path/to/tmp

# --- the run ---------------------------------------------------------------
EXP=exp/stage2_v9c
CONFIG=conf/stage2_v9c.yaml
# initial checkpoint with its head record <INIT>.head.json
# (local/init/build_init.sh)
INIT=exp/init/stage2_init.pt
# epochs per job: as many as fit into the time limit, the last one included
EPOCHS_PER_SEG=14
# GPUs of the job x data.loader.batch_size. The learning rate and the steps
# per epoch follow from it; the job stops if it is not this number.
EXPECT_GLOBAL_BATCH=384
# 1: copy the noise and the simulated-reverb LMDB to /dev/shm (about 14 GB of
# node memory) so that they stay in memory; 0: read them in place
AUG_TO_SHM=1

# --- drift gate ------------------------------------------------------------
# After every epoch: ||encoder - reference|| / ||reference|| must not exceed
# DRIFT_GATE (local/drift_gate.py). The reference needs every tensor of the
# model except the classifier head; the initial checkpoint qualifies. The
# reference run used 0.08 and ended at 0.044.
DRIFT_REF=exp/init/stage2_init.pt
DRIFT_GATE=0.08
